+load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
+
+# Feature module WGExteraBadge: the real public exteraGram badge catalog in Wraithgram.
+# Never depends on TelegramUI or another WG<Feature> module (FOUNDATION_SPEC §1.1).
+swift_library(
+    name = "WGExteraBadge",
+    module_name = "WGExteraBadge",
+    srcs = glob([
+        "Sources/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    deps = [
+        "//Wraithgram/WGCore:WGCore",
+        "//Wraithgram/WGHooks:WGHooks",
+        "//Wraithgram/WGSettingsUI:WGSettingsUI",
+        "//submodules/SSignalKit/SwiftSignalKit:SwiftSignalKit",
+        "//submodules/AsyncDisplayKit:AsyncDisplayKit",
+        "//submodules/Postbox:Postbox",
+        "//submodules/TelegramCore:TelegramCore",
+        "//submodules/AccountContext:AccountContext",
+        "//submodules/ChatListUI:ChatListUI",
+        "//submodules/TelegramPresentationData:TelegramPresentationData",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
diff --git a/Wraithgram/Features/ExteraBadge/Sources/API/WGExteraBadgeAPI.swift b/Wraithgram/Features/ExteraBadge/Sources/API/WGExteraBadgeAPI.swift
new file mode 100644
--- a/Wraithgram/Features/ExteraBadge/Sources/API/WGExteraBadgeAPI.swift
+++ b/Wraithgram/Features/ExteraBadge/Sources/API/WGExteraBadgeAPI.swift
@@ -0,0 +1,53 @@
+import Foundation
+import SwiftSignalKit
+import WGCore
+
+/// The real public exteraGram badge feed, exactly the endpoint the Android client uses
+/// (`ApiService.getAllProfiles`): `GET https://api.exteragram.app/api/v1/profiles`.
+///
+/// The whole catalog is fetched (an anonymous list); no Telegram user id is put into the URL.
+/// ETag is reused through `WGNetworkRequest.etag`, so a 304 costs almost nothing. No extra headers,
+/// no token, no fake badge: if the server does not list a user, the app shows nothing.
+enum WGExteraBadgeAPI {
+    static let baseURL = "https://api.exteragram.app/api/v1/"
+    static let requestTimeout: Double = 15.0
+    static let maxResponseBytes = 2 * 1024 * 1024
+
+    enum WGExteraBadgeResult {
+        case updated(WGExteraBadgeSnapshot)
+        case notModified
+        case failed
+    }
+
+    static var profilesURL: URL? {
+        return URL(string: baseURL + "profiles")
+    }
+
+    static func fetch(etag: String?) -> Signal<WGExteraBadgeResult, NoError> {
+        guard let url = WGExteraBadgeAPI.profilesURL else {
+            return .single(.failed)
+        }
+        let request = WGNetworkRequest(url: url, etag: etag, maxBytes: WGExteraBadgeAPI.maxResponseBytes)
+        return WGNetwork.shared.fetch(request)
+        |> map { response -> WGExteraBadgeResult in
+            if response.notModified {
+                return .notModified
+            }
+            guard let data = response.data else {
+                return .failed
+            }
+            do {
+                let decoder = JSONDecoder()
+                let profiles = try decoder.decode([WGExteraBadgeProfile].self, from: data)
+                let snapshot = WGExteraBadgeSnapshot(profiles: profiles, etag: response.etag ?? etag, fetchedAt: WGExteraBadgeStore.now())
+                return .updated(snapshot)
+            } catch {
+                return .failed
+            }
+        }
+        |> `catch` { _ -> Signal<WGExteraBadgeResult, NoError> in
+            return .single(.failed)
+        }
+        |> timeout(WGExteraBadgeAPI.requestTimeout, queue: Queue.concurrentDefaultQueue(), alternate: .single(.failed))
+    }
+}
diff --git a/Wraithgram/Features/ExteraBadge/Sources/ChatList/WGExteraBadgeChatList.swift b/Wraithgram/Features/ExteraBadge/Sources/ChatList/WGExteraBadgeChatList.swift
new file mode 100644
--- a/Wraithgram/Features/ExteraBadge/Sources/ChatList/WGExteraBadgeChatList.swift
+++ b/Wraithgram/Features/ExteraBadge/Sources/ChatList/WGExteraBadgeChatList.swift
@@ -0,0 +1,66 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import Postbox
+import TelegramCore
+import AccountContext
+import ChatListUI
+import WGCore
+import WGHooks
+
+/// Compact exteraGram badge next to the title of a user's chat row.
+///
+/// The catalog is public and anonymous; a row layout only reads the local cache. When the cache
+/// changes, `accessoryPeers` re-lays out the listed peers once (not on a timer).
+enum WGExteraBadgeChatList {
+    private static let pillTag = 9932
+
+    static func register() {
+        WGChatListHooks.rowDidLayout.register({ layout in
+            WGExteraBadgeChatList.updateRow(layout)
+        })
+
+        WGChatListHooks.accessoryPeers.register({ _ in
+            return combineLatest(WGExteraBadgeSettings.enabled.signal, WGExteraBadgeSettings.cache.signal)
+            |> map { enabled, snapshot -> Set<EnginePeer.Id> in
+                guard enabled else {
+                    return Set()
+                }
+                return Set(snapshot.profiles.compactMap { profile in
+                    guard !profile.deleted, profile.displayText != nil else {
+                        return nil
+                    }
+                    return EnginePeer.Id(namespace: Namespaces.Peer.CloudUser, id: EnginePeer.Id.Id._internalFromInt64Value(profile.id))
+                })
+            }
+            |> distinctUntilChanged
+        })
+    }
+
+    private static func updateRow(_ layout: WGChatListRowLayout) {
+        guard WGExteraBadgeSettings.enabled.value, WGExteraBadgeSettings.showInChatList.value else {
+            return
+        }
+        guard let peer = layout.peer, case let .user(user) = peer else {
+            return
+        }
+        WGExteraBadgeStore.shared.refreshIfNeeded()
+        guard let profile = WGExteraBadgeStore.shared.badge(for: user.id.id._internalGetInt64Value()), let text = profile.displayText else {
+            return
+        }
+
+        let container = layout.node.view
+        let pill: WGExteraBadgePillView
+        if let existing = container.viewWithTag(pillTag) as? WGExteraBadgePillView {
+            pill = existing
+        } else {
+            pill = WGExteraBadgePillView(frame: .zero)
+            pill.tag = pillTag
+            pill.autoresizingMask = [.flexibleLeftMargin, .flexibleTopMargin, .flexibleBottomMargin]
+            container.addSubview(pill)
+        }
+        pill.update(text: text, color: profile.isDeveloper ? UIColor.systemPurple : UIColor.systemBlue)
+        let size = pill.sizeThatFits(CGSize(width: 120, height: 15))
+        pill.frame = CGRect(x: layout.titleFrame.maxX + 4, y: layout.titleFrame.midY - 8.0, width: size.width, height: 15.0)
+    }
+}
diff --git a/Wraithgram/Features/ExteraBadge/Sources/Menu/WGExteraBadgeMenu.swift b/Wraithgram/Features/ExteraBadge/Sources/Menu/WGExteraBadgeMenu.swift
