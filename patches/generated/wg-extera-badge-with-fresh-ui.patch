@@ -0,0 +1,52 @@
+import Foundation
+import WGCore
+import WGSettingsUI
+
+/// Rows in the existing «Профиль и Настройки › Профиль» section. No new tab is needed: the badge
+/// is a small profile/chat-list decoration, not a separate settings world.
+enum WGExteraBadgeMenu {
+    static func register() {
+        WGMenuRegistry.register(WGMenuRow(
+            id: "exteraBadge.enabled",
+            section: .swiftgramProfilesInfo,
+            order: 400,
+            title: { "Бейджи exteraGram" },
+            subtitle: { "Статусы SUPPORTER / DEVELOPER из публичного API exteraGram" },
+            icon: .system("rosette"),
+            kind: .toggle(.global(WGExteraBadgeSettings.enabled))
+        ))
+        WGMenuRegistry.register(WGMenuRow(
+            id: "exteraBadge.inProfile",
+            section: .swiftgramProfilesInfo,
+            order: 410,
+            title: { "Бейдж в профиле" },
+            kind: .toggle(.global(WGExteraBadgeSettings.showInProfile)),
+            isVisible: { _ in WGExteraBadgeSettings.enabled.value }
+        ))
+        WGMenuRegistry.register(WGMenuRow(
+            id: "exteraBadge.inChatList",
+            section: .swiftgramProfilesInfo,
+            order: 420,
+            title: { "Бейдж в списке чатов" },
+            kind: .toggle(.global(WGExteraBadgeSettings.showInChatList)),
+            isVisible: { _ in WGExteraBadgeSettings.enabled.value }
+        ))
+        WGMenuRegistry.register(WGMenuRow(
+            id: "exteraBadge.refresh",
+            section: .swiftgramProfilesInfo,
+            order: 430,
+            title: { "Обновить список бейджей" },
+            subtitle: { "Запрос к api.exteragram.app (только публичный список)" },
+            icon: .system("arrow.triangle.2.circlepath"),
+            kind: .action({ context in
+                WGExteraBadgeStore.shared.refreshIfNeeded(force: true)
+                context.presentToast("Запрос к exteraGram отправлен")
+            }),
+            isVisible: { _ in WGExteraBadgeSettings.enabled.value },
+            label: { _ in
+                let count = WGExteraBadgeStore.shared.snapshot.profiles.count
+                return count > 0 ? "\(count)" : "—"
+            }
+        ))
+    }
+}
diff --git a/Wraithgram/Features/ExteraBadge/Sources/Model/WGExteraBadgeModel.swift b/Wraithgram/Features/ExteraBadge/Sources/Model/WGExteraBadgeModel.swift
new file mode 100644
--- a/Wraithgram/Features/ExteraBadge/Sources/Model/WGExteraBadgeModel.swift
+++ b/Wraithgram/Features/ExteraBadge/Sources/Model/WGExteraBadgeModel.swift
@@ -0,0 +1,121 @@
+import Foundation
+import WGCore
+
+/// DTO of `GET https://api.exteragram.app/api/v1/profiles`.
+///
+/// Mirrors exteraGram's `ApiProfile` / `Badge` (`BadgesController`):
+/// `id`, `type`, `status` (`DEFAULT | DEVELOPER | SUPPORTER`), `badge {documentId, text}`,
+/// `number`, `deleted`, `canChangeBadge`. Unknown fields are ignored so a server addition does
+/// not break the app.
+struct WGExteraBadgeDocument: Codable, Equatable, WGSettingValue {
+    let documentId: Int64?
+    let text: String?
+
+    private enum CodingKeys: String, CodingKey {
+        case documentId
+        case text
+    }
+
+    init(documentId: Int64?, text: String?) {
+        self.documentId = documentId
+        self.text = text
+    }
+
+    init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.documentId = try container.decodeIfPresent(Int64.self, forKey: .documentId)
+        self.text = try container.decodeIfPresent(String.self, forKey: .text)
+    }
+}
+
+/// `id` is sent as a number by the Android client; accept a decimal string as well.
+private struct WGExteraFlexibleInt64: Decodable {
+    let value: Int64
+
+    init(from decoder: Decoder) throws {
+        let container = try decoder.singleValueContainer()
+        if let number = try? container.decode(Int64.self) {
+            self.value = number
+        } else if let string = try? container.decode(String.self), let number = Int64(string) {
+            self.value = number
+        } else {
+            throw DecodingError.typeMismatch(Int64.self, DecodingError.Context(codingPath: decoder.codingPath, debugDescription: "Expected an integer or decimal string"))
+        }
+    }
+}
+
+struct WGExteraBadgeProfile: Codable, Equatable, WGSettingValue {
+    let id: Int64
+    let type: String?
+    let status: String?
+    let badge: WGExteraBadgeDocument?
+    let number: Int?
+    let deleted: Bool
+    let canChangeBadge: Bool
+
+    private enum CodingKeys: String, CodingKey {
+        case id
+        case type
+        case status
+        case badge
+        case number
+        case deleted
+        case canChangeBadge
+    }
+
+    init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        // The Android client uses a Long id; accept a decimal string too, so a server-side
+        // serialization change cannot silently hide every badge.
+        guard let id = try container.decodeIfPresent(WGExteraFlexibleInt64.self, forKey: .id) else {
+            throw DecodingError.keyNotFound(CodingKeys.id, DecodingError.Context(codingPath: decoder.codingPath, debugDescription: "Missing profile id"))
+        }
+        self.id = id.value
+        self.type = try container.decodeIfPresent(String.self, forKey: .type)
+        self.status = try container.decodeIfPresent(String.self, forKey: .status)
+        self.badge = try container.decodeIfPresent(WGExteraBadgeDocument.self, forKey: .badge)
+        self.number = try container.decodeIfPresent(Int.self, forKey: .number)
+        self.deleted = try container.decodeIfPresent(Bool.self, forKey: .deleted) ?? false
+        self.canChangeBadge = try container.decodeIfPresent(Bool.self, forKey: .canChangeBadge) ?? false
+    }
+
+    var isSupporter: Bool {
+        return self.status == "SUPPORTER"
+    }
+
+    var isDeveloper: Bool {
+        return self.status == "DEVELOPER"
+    }
+
+    /// The text to draw in the pill. Never invent a title: prefer the server text, then the status.
+    var displayText: String? {
+        if let text = self.badge?.text, !text.isEmpty {
+            return text
+        }
+        switch self.status {
+        case "SUPPORTER":
+            return "SUPPORTER"
+        case "DEVELOPER":
+            return "DEVELOPER"
+        default:
+            return nil
+        }
+    }
+}
+
+/// The cached answer of the whole public catalog (no user id leaves the device in a request).
+struct WGExteraBadgeSnapshot: Codable, Equatable, WGSettingValue {
+    let profiles: [WGExteraBadgeProfile]
+    let etag: String?
+    let fetchedAt: Int32
+
+    init(profiles: [WGExteraBadgeProfile], etag: String?, fetchedAt: Int32) {
+        self.profiles = profiles
+        self.etag = etag
+        self.fetchedAt = fetchedAt
+    }
+
+    func profile(for userId: Int64) -> WGExteraBadgeProfile? {
+        return self.profiles.first(where: { $0.id == userId && !$0.deleted })
+    }
+}
diff --git a/Wraithgram/Features/ExteraBadge/Sources/Profile/WGExteraBadgeProfile.swift b/Wraithgram/Features/ExteraBadge/Sources/Profile/WGExteraBadgeProfile.swift
new file mode 100644
--- a/Wraithgram/Features/ExteraBadge/Sources/Profile/WGExteraBadgeProfile.swift
+++ b/Wraithgram/Features/ExteraBadge/Sources/Profile/WGExteraBadgeProfile.swift
@@ -0,0 +1,71 @@
+import Foundation
+import UIKit
+import AsyncDisplayKit
+import TelegramCore
+import WGCore
+import WGHooks
+
+/// Badge in a user's profile: an info row plus a compact pill beside the name.
+///
+/// The status always comes from the public exteraGram catalog. Opening a profile may start a
+/// rate-limited refresh; the next layout draws the answer. Nothing is granted locally.
+enum WGExteraBadgeProfileUI {
+    private static let pillTag = 9931
+
+    static func register() {
+        WGPeerInfoHooks.infoRows.register({ info in
+            return WGExteraBadgeProfileUI.rows(info)
+        }, order: 120)
+
+        WGPeerInfoHooks.headerDidLayout.register({ header in
+            WGExteraBadgeProfileUI.updateHeader(header)
+        }, order: 120)
+    }
+
+    private static func rows(_ info: WGPeerInfoContext) -> [WGPeerInfoRow] {
+        guard WGExteraBadgeSettings.enabled.value, WGExteraBadgeSettings.showInProfile.value, !info.isSettings else {
+            return []
+        }
+        guard case let .user(user) = info.peer else {
+            return []
+        }
+        WGExteraBadgeStore.shared.refreshIfNeeded()
+        guard let profile = WGExteraBadgeStore.shared.badge(for: user.id.id._internalGetInt64Value()) else {
+            return []
+        }
+        guard let text = profile.displayText else {
+            return []
+        }
+        let label = profile.isDeveloper ? "Разработчик exteraGram" : "Саппортер exteraGram"
+        return [WGPeerInfoRow(id: "exteraBadge.profile", label: label, text: text)]
+    }
+
+    private static func updateHeader(_ header: WGPeerInfoHeader) {
+        guard WGExteraBadgeSettings.enabled.value, WGExteraBadgeSettings.showInProfile.value, !header.isSettings, let peer = header.peer else {
+            return
+        }
+        guard case let .user(user) = peer else {
+            return
+        }
+        WGExteraBadgeStore.shared.refreshIfNeeded()
+        guard let profile = WGExteraBadgeStore.shared.badge(for: user.id.id._internalGetInt64Value()), let text = profile.displayText else {
+            return
+        }
+
+        // The header exposes the name's own views; fall back to the header itself.
+        let container = header.titleStateViews.last ?? header.node.view
+        let pill: WGExteraBadgePillView
+        if let existing = container.viewWithTag(pillTag) as? WGExteraBadgePillView {
+            pill = existing
+        } else {
+            pill = WGExteraBadgePillView(frame: CGRect(x: container.bounds.width + 4, y: 0, width: 0, height: 17))
+            pill.tag = pillTag
+            pill.autoresizingMask = [.flexibleLeftMargin, .flexibleTopMargin, .flexibleBottomMargin]
+            container.addSubview(pill)
+        }
+        let color = profile.isDeveloper ? UIColor.systemPurple : UIColor.systemBlue
+        pill.update(text: text, color: color)
+        let size = pill.sizeThatFits(CGSize(width: 160, height: 17))
+        pill.frame.size = CGSize(width: size.width, height: 17)
+    }
+}
diff --git a/Wraithgram/Features/ExteraBadge/Sources/Settings/WGExteraBadgeSettings.swift b/Wraithgram/Features/ExteraBadge/Sources/Settings/WGExteraBadgeSettings.swift
new file mode 100644
--- a/Wraithgram/Features/ExteraBadge/Sources/Settings/WGExteraBadgeSettings.swift
+++ b/Wraithgram/Features/ExteraBadge/Sources/Settings/WGExteraBadgeSettings.swift
@@ -0,0 +1,23 @@
+import Foundation
+import WGCore
+
+enum WGExteraBadgeSettings {
+    /// Master switch: off means no requests at all and no badge drawn.
+    static let enabled = WGSetting<Bool>("exteraBadge.enabled", default: true)
+    /// Show the server's badge in the profile's info section.
+    static let showInProfile = WGSetting<Bool>("exteraBadge.showInProfile", default: true)
+    /// Show a compact pill next to the chat title in the chat list.
+    static let showInChatList = WGSetting<Bool>("exteraBadge.showInChatList", default: true)
+    /// Seconds between two full catalog requests (exteraGram uses ~10 minutes).
+    static let refreshInterval = WGSetting<Int>("exteraBadge.refreshInterval", default: 600)
+    /// Last good answer. Not exported: a cache, not a user preference.
+    static let cache = WGSetting<WGExteraBadgeSnapshot>("exteraBadge.cache", default: WGExteraBadgeSnapshot(profiles: [], etag: nil, fetchedAt: 0), flags: [.noExport])
+
+    static func declare() {
+        let _ = WGExteraBadgeSettings.enabled
+        let _ = WGExteraBadgeSettings.showInProfile
+        let _ = WGExteraBadgeSettings.showInChatList
+        let _ = WGExteraBadgeSettings.refreshInterval
+        let _ = WGExteraBadgeSettings.cache
+    }
+}
diff --git a/Wraithgram/Features/ExteraBadge/Sources/Store/WGExteraBadgeStore.swift b/Wraithgram/Features/ExteraBadge/Sources/Store/WGExteraBadgeStore.swift
new file mode 100644
--- a/Wraithgram/Features/ExteraBadge/Sources/Store/WGExteraBadgeStore.swift
+++ b/Wraithgram/Features/ExteraBadge/Sources/Store/WGExteraBadgeStore.swift
@@ -0,0 +1,70 @@
+import Foundation
+import SwiftSignalKit
+import WGCore
+
+/// Cache and refresh policy of the public exteraGram catalog.
+///
+/// Main thread. Refreshes at most once per `refreshInterval` (10 minutes — the same order as
+/// exteraGram's `BadgesController`), reuses the ETag, and keeps the last good snapshot on any
+/// failure. The cache is `.noExport`: it is public data, not a user setting.
+final class WGExteraBadgeStore {
+    static let shared = WGExteraBadgeStore()
+
+    private var inFlight = false
+    private var lastRefresh: Int32 = 0
+    private let disposables = DisposableSet()
+
+    private init() {
+    }
+
+    static func now() -> Int32 {
+        return Int32(clamping: Int(Date().timeIntervalSince1970))
+    }
+
+    var snapshot: WGExteraBadgeSnapshot {
+        return WGExteraBadgeSettings.cache.value
+    }
+
+    func badge(for userId: Int64) -> WGExteraBadgeProfile? {
+        guard WGExteraBadgeSettings.enabled.value else {
+            return nil
+        }
+        return self.snapshot.profile(for: userId)
+    }
+
+    func badgeText(for userId: Int64) -> String? {
+        return self.badge(for: userId)?.displayText
+    }
+
+    /// Called when a profile opens and from the settings screen. `force` is used by the
+    /// «Обновить» row.
+    func refreshIfNeeded(force: Bool = false) {
+        assert(Thread.isMainThread)
+        guard WGExteraBadgeSettings.enabled.value, !self.inFlight else {
+            return
+        }
+        let now = WGExteraBadgeStore.now()
+        let last = max(self.lastRefresh, self.snapshot.fetchedAt)
+        if !force, last > 0, now - last < Int32(WGExteraBadgeSettings.refreshInterval.value) {
+            return
+        }
+        self.inFlight = true
+        let etag = self.snapshot.etag
+        self.disposables.add((WGExteraBadgeAPI.fetch(etag: etag)
+        |> deliverOnMainQueue).start(next: { [weak self] result in
+            guard let self else {
+                return
+            }
+            self.inFlight = false
+            self.lastRefresh = WGExteraBadgeStore.now()
+            switch result {
+            case let .updated(snapshot):
+                WGExteraBadgeSettings.cache.set(snapshot)
+            case .notModified:
+                break
+            case .failed:
+                break
+            }
+        }))
+    }
+}
diff --git a/Wraithgram/Features/ExteraBadge/Sources/UI/WGExteraBadgeUI.swift b/Wraithgram/Features/ExteraBadge/Sources/UI/WGExteraBadgeUI.swift
new file mode 100644
--- a/Wraithgram/Features/ExteraBadge/Sources/UI/WGExteraBadgeUI.swift
+++ b/Wraithgram/Features/ExteraBadge/Sources/UI/WGExteraBadgeUI.swift
@@ -0,0 +1,51 @@
+import Foundation
+import UIKit
+
+/// A small pill drawn next to a name (chat list / profile header).
+///
+/// The real exteraGram badge is a remote document (`badge.documentId`). Resolving an arbitrary
+/// Telegram document id to a local UIImage requires a Telegram file-reference context, which a
+/// feature module does not have in the header layout path. To keep the patch safe and honest, the
+/// pill shows the server's own `badge.text` (or a localized status name); no badge artwork is
+/// faked locally. Swap this view for an AsyncDisplayKit image node if you later add a document
+/// resolver in Wraithgram's own layer.
+final class WGExteraBadgePillView: UIView {
+    private let label = UILabel()
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isUserInteractionEnabled = false
+        self.layer.cornerRadius = 5.0
+        self.layer.masksToBounds = true
+        self.label.font = .systemFont(ofSize: 11, weight: .semibold)
+        self.label.textAlignment = .center
+        self.label.textColor = .white
+        self.addSubview(self.label)
+        self.label.translatesAutoresizingMaskIntoConstraints = false
+        NSLayoutConstraint.activate([
+            self.label.leadingAnchor.constraint(equalTo: self.leadingAnchor, constant: 5),
+            self.label.trailingAnchor.constraint(equalTo: self.trailingAnchor, constant: -5),
+            self.label.topAnchor.constraint(equalTo: self.topAnchor, constant: 1),
+            self.label.bottomAnchor.constraint(equalTo: self.bottomAnchor, constant: -1)
+        ])
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    func update(text: String?, color: UIColor) {
+        guard let text, !text.isEmpty else {
+            self.isHidden = true
+            return
+        }
+        self.isHidden = false
+        self.backgroundColor = color.withAlphaComponent(0.85)
+        self.label.text = text
+    }
+
+    override func sizeThatFits(_ size: CGSize) -> CGSize {
+        let textSize = self.label.sizeThatFits(CGSize(width: size.width - 10, height: size.height - 2))
+        return CGSize(width: ceil(textSize.width) + 10, height: ceil(textSize.height) + 2)
+    }
+}
