diff --git a/.github/workflows/build-simulator.yml b/.github/workflows/build-simulator.yml
new file mode 100644
--- a/.github/workflows/build-simulator.yml
+++ b/.github/workflows/build-simulator.yml
@@ -0,0 +1,122 @@
+# Builds a simulator app only — no resigned IPA, no signing certificate, no sideloading.
+#
+# Run it in your fork: Actions → "Build for Simulator (no IPA)" → Run workflow.
+# The artifact is a ZIP with Telegram.app, not an .ipa. See docs/BUILD_SIMULATOR.md.
+# Your own TELEGRAM_API_ID / TELEGRAM_API_HASH secrets are recommended; without them the
+# template's public api_id 8 is used and the build logs a warning.
+
+name: Build for Simulator (no IPA)
+
+on:
+  workflow_dispatch:
+    inputs:
+      bundle_id:
+        description: "Bundle ID for the simulator app, e.g. com.yourname.wraithgram.sim"
+        required: true
+        default: "com.wraithgram.mod"
+      runner:
+        description: "Runner label; it must have the Xcode version from versions.json"
+        required: true
+        default: "xcode-27"
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    runs-on: ${{ inputs.runner }}
+    timeout-minutes: 360
+
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          submodules: recursive
+
+      - name: Select the Xcode from versions.json
+        run: |
+          XCODE_VERSION="$(python3 -c 'import json; print(json.load(open("versions.json"))["xcode"])')"
+          XCODE_PATH="/Applications/Xcode_${XCODE_VERSION}.app"
+          if [ ! -d "$XCODE_PATH" ]; then
+            echo "::error::$XCODE_PATH is not on this runner. Installed: $(echo /Applications/Xcode_*.app)"
+            exit 1
+          fi
+          sudo xcode-select -s "$XCODE_PATH/Contents/Developer"
+          if [ -L /Applications/Xcode.app ] || [ ! -e /Applications/Xcode.app ]; then
+            sudo ln -sfn "$XCODE_PATH" /Applications/Xcode.app
+          fi
+          echo "XCODE_PATH=$XCODE_PATH" >> "$GITHUB_ENV"
+          xcodebuild -version
+
+      - name: Free disk space
+        run: |
+          df -h /
+          for xcode in /Applications/Xcode_*.app; do
+            [ "$(cd "$xcode" && pwd -P)" = "$(cd "$XCODE_PATH" && pwd -P)" ] || sudo rm -rf "$xcode"
+          done
+          sudo rm -rf "$HOME/Library/Android" /usr/local/share/dotnet "$HOME/.dotnet" "$HOME/hostedtoolcache" || true
+          df -h /
+
+      - name: Write the simulator configuration
+        env:
+          API_ID: ${{ secrets.TELEGRAM_API_ID }}
+          API_HASH: ${{ secrets.TELEGRAM_API_HASH }}
+          BUNDLE_ID: ${{ inputs.bundle_id }}
+        run: |
+          python3 - <<'PY'
+          import json, os
+          config = json.load(open("build-system/wraithgram-configuration.example.json"))
+          config.pop("_warning", None)
+          if os.environ.get("API_ID") and os.environ.get("API_HASH"):
+              config["api_id"] = os.environ["API_ID"]
+              config["api_hash"] = os.environ["API_HASH"]
+          else:
+              print("::warning::TELEGRAM_API_ID / TELEGRAM_API_HASH secrets are not set: building with Telegram's own api_id 8.")
+          config["bundle_id"] = os.environ["BUNDLE_ID"].strip()
+          json.dump(config, open("build-system/wraithgram-configuration.json", "w"), indent=2)
+          PY
+
+      - name: Build for simulator
+        env:
+          WG_BAZEL_CACHE: ""
+          WG_BUILD_LOG: ${{ runner.temp }}/wg-build.log
+        run: build-system/WGBuild.sh
+
+      - name: Package Wraithgram.app (not an IPA)
+        run: |
+          set -e
+          ls -l bazel-bin/Telegram/Telegram.ipa
+          unzip -l bazel-bin/Telegram/Telegram.ipa | head -30 || true
+          mkdir -p sim-unpack
+          unzip -q bazel-bin/Telegram/Telegram.ipa -d sim-unpack
+          echo "Extracted apps:"
+          find -L sim-unpack -name '*.app' -print || true
+          # Telegram/BUILD sets bundle_name = "Wraithgram", so the payload is Wraithgram.app.
+          APP_DIR="$(find -L sim-unpack -type d -name 'Wraithgram.app' -print -quit 2>/dev/null || true)"
+          if [ -z "$APP_DIR" ]; then
+            APP_DIR="$(find -L sim-unpack -type d -name '*.app' -print -quit 2>/dev/null || true)"
+          fi
+          if [ -z "$APP_DIR" ]; then
+            echo "::error::No .app was found in bazel-bin/Telegram/Telegram.ipa"
+            exit 1
+          fi
+          mkdir -p simulator-output
+          cp -RL "$APP_DIR" simulator-output/Wraithgram.app
+          (cd simulator-output && zip -qry "$GITHUB_WORKSPACE/wraithgram-simulator-app.zip" Wraithgram.app)
+          echo "Packaged: $APP_DIR"
+
+      - name: Upload the simulator app
+        uses: actions/upload-artifact@v4
+        with:
+          name: Wraithgram-simulator-app
+          path: wraithgram-simulator-app.zip
+          retention-days: 7
+          if-no-files-found: error
+
+      - name: Upload the build log
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: build-log-simulator
+          path: ${{ runner.temp }}/wg-build.log
+          retention-days: 3
+          if-no-files-found: ignore
