+++ b/Wraithgram/Features/QuickActions/BUILD
@@ -0,0 +1,32 @@
+load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
+
+# Feature module WGQuickActions: two small Reza-inspired conveniences implemented with the
+# existing WGHooks surface:
+#   - double tap on a message → repeat it to Saved Messages;
+#   - show the message id and the timestamp with seconds in the status line.
+# No upstream/submodule edits. Never depends on TelegramUI or another WG<Feature> module.
+swift_library(
+    name = "WGQuickActions",
+    module_name = "WGQuickActions",
+    srcs = glob([
+        "Sources/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    deps = [
+        "//Wraithgram/WGCore:WGCore",
+        "//Wraithgram/WGHooks:WGHooks",
+        "//Wraithgram/WGSettingsUI:WGSettingsUI",
+        "//Wraithgram/Features/Shared:WGFeaturesShared",
+        "//submodules/SSignalKit/SwiftSignalKit:SwiftSignalKit",
+        "//submodules/Postbox:Postbox",
+        "//submodules/TelegramCore:TelegramCore",
+        "//submodules/AccountContext:AccountContext",
+        "//submodules/TelegramPresentationData:TelegramPresentationData",
+        "//submodules/UndoUI:UndoUI",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
diff --git a/Wraithgram/Features/QuickActions/Sources/Decorations/WGQuickActionsDecorations.swift b/Wraithgram/Features/QuickActions/Sources/Decorations/WGQuickActionsDecorations.swift
new file mode 100644
--- a/Wraithgram/Features/QuickActions/Sources/Decorations/WGQuickActionsDecorations.swift
+++ b/Wraithgram/Features/QuickActions/Sources/Decorations/WGQuickActionsDecorations.swift
@@ -0,0 +1,36 @@
+import Foundation
+import Postbox
+import TelegramCore
+import AccountContext
+import WGCore
+import WGHooks
+
+enum WGQuickActionsDecorations {
+    static func register() {
+        // Late handler: append to whatever AntiDelete / Messages / Appearance already put into the
+        // status line instead of replacing their marks.
+        WGMessageDecorationHooks.decorations.register({ decoration, context in
+            guard WGQuickActionsSettings.showMessageIdAndSeconds.value else {
+                return
+            }
+            let marker = WGQuickActionsDecorations.marker(for: context.message)
+            if let current = decoration.statusPrefix {
+                decoration.statusPrefix = current + "· " + marker
+            } else {
+                decoration.statusPrefix = marker
+            }
+        }, order: 950)
+    }
+
+    private static func marker(for message: Message) -> String {
+        let date = Date(timeIntervalSince1970: Double(message.timestamp))
+        let components = Calendar(identifier: .gregorian).dateComponents([.hour, .minute, .second], from: date)
+        let time = String(
+            format: "%02d:%02d:%02d",
+            components.hour ?? 0,
+            components.minute ?? 0,
+            components.second ?? 0
+        )
+        return "#\(message.id.id) \(time) "
+    }
+}
diff --git a/Wraithgram/Features/QuickActions/Sources/Gestures/WGQuickActionsGestures.swift b/Wraithgram/Features/QuickActions/Sources/Gestures/WGQuickActionsGestures.swift
new file mode 100644
--- a/Wraithgram/Features/QuickActions/Sources/Gestures/WGQuickActionsGestures.swift
+++ b/Wraithgram/Features/QuickActions/Sources/Gestures/WGQuickActionsGestures.swift
@@ -0,0 +1,53 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import Postbox
+import TelegramCore
+import AccountContext
+import TelegramPresentationData
+import UndoUI
+import WGCore
+import WGHooks
+import WGFeaturesShared
+
+enum WGQuickActionsGestures {
+    static func register() {
+        // WGMessages' «double tap → edit» is registered at order 0 and returns true only when it
+        // actually handled the tap. Our handler runs after it (order 50), so enabling both is safe.
+        WGMessageGestureHooks.tap.register({ request in
+            guard request.tapCount == 2, WGQuickActionsSettings.doubleTapRepeatToSaved.value else {
+                return false
+            }
+            // Saved Messages → Saved Messages would only create duplicates.
+            guard request.message.id.peerId != request.context.account.peerId else {
+                return false
+            }
+            WGQuickActionsGestures.repeatToSaved(request.message, context: request.context)
+            return true
+        }, order: 50)
+    }
+
+    /// Forwards one message to the account's Saved Messages using the same pipeline as the existing
+    /// «В Избранное» menu item (including copy fallbacks for protected media).
+    private static func repeatToSaved(_ message: Message, context: AccountContext) {
+        WGForwardSend.send(
+            account: context.account,
+            messages: [message],
+            to: [WGForwardSend.Target(peerId: context.account.peerId, threadId: nil)],
+            hideNames: false,
+            hideCaptions: false,
+            completion: { result in
+                let text = result.messages.isEmpty
+                    ? "Не удалось добавить сообщение в Избранное"
+                    : "Сообщение добавлено в Избранное"
+                let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+                context.sharedContext.mainWindow?.present(UndoOverlayController(
+                    presentationData: presentationData,
+                    content: .info(title: nil, text: text, timeout: nil, customUndoText: nil),
+                    elevatedLayout: false,
+                    action: { _ in false }
+                ), on: .root)
+            }
+        )
+    }
+}
